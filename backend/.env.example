# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development

# Supabase → Project Settings → Database → Connection string → URI (Session pooler mode)
DATABASE_URL=postgresql://postgres.xxxxx:your-password@aws-0-region.pooler.supabase.com:5432/postgres

CORS_ORIGINS=["http://localhost:8080"]

# OANDA v20 API → My Account → My Services → Manage API Access → generate token
OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice
# fxTrade practice portal dashboard — only needed for live streaming (Phase 5)
OANDA_ACCOUNT_ID=

# Upstash → Redis database → Connect → rediss:// URL
REDIS_URL=
